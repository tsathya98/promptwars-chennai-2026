# Required: gpt-5.6-terra via the Responses API.
OPENAI_API_KEY=

# Optional override. This project defaults to the region-pinned host below;
# the standard api.openai.com hostname rejects this key.
OPENAI_BASE_URL=https://us.api.openai.com/v1

# Optional second provider (model-agnostic switch)
GEMINI_API_KEY=
# openai (default) | gemini
MODEL_PROVIDER=
