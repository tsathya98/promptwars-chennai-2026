# ── LLM provider routing ──────────────────────────────────────────────
# antigravity (default): use the local `agy` CLI on your Google-account
#   subscription quota FIRST for non-interactive generation. lib/llm.ts
#   checks that agy is actually installed+working (agyAvailable()) and
#   silently falls back to the API key if not.
# api: force the Gemini API-key path. REQUIRED on Vercel/Docker/CI where
#   agy does not exist. Streaming chat always uses the API key regardless.
LLM_PROVIDER=antigravity

# ── Gemini API keys (AI Studio → aistudio.google.com) ─────────────────
GEMINI_API_KEY=
# Same value as GEMINI_API_KEY — @ai-sdk/google reads this name.
GOOGLE_GENERATIVE_AI_API_KEY=
# Key from a SECOND Google account/project — last rung of the 429 ladder.
GEMINI_API_KEY_FALLBACK=

# ── Auth (only if google-auth skill is used) ──────────────────────────
# npx auth secret
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Dev switches ──────────────────────────────────────────────────────
# 1 = serve canned fixtures from fixtures/ — zero-token UI iteration.
MOCK=0
